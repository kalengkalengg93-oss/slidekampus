      { title: "Pembahasan", bullets: ["Faktor pendukung", "Faktor penghambat", "Contoh penerapan"] },
      { title: "Strategi dan Solusi", bullets: ["Langkah praktis yang dapat dilakukan", "Peran pihak terkait", "Indikator keberhasilan"] },
