      { title: "Tantangan ke Depan", bullets: ["Hambatan yang mungkin muncul", "Peluang pengembangan"] },
      { title: "Kesimpulan", bullets: ["Poin inti pembahasan", "Rekomendasi", "Penutup"] },
    ];
    return {
      title: topic,
      slides: base.slice(0, Math.max(3, count - 2)).map(s => ({ ...s, notes: "" })),
      demo: true
    };
  }

  function render() {
    const box = $("slides");
    box.innerHTML = "";
    const cover = document.createElement("div");
    cover.className = "slide cover";
    cover.innerHTML = `<h3></h3><ul style="list-style:none;padding:0"><li>Pratinjau judul</li></ul>`;
    cover.querySelector("h3").textContent = deck.title;
    box.appendChild(cover);
    deck.slides.forEach((s, i) => {
      const el = document.createElement("div");
      el.className = "slide";
      const h = document.createElement("h3"); h.textContent = s.title;
      const ul = document.createElement("ul");
      s.bullets.forEach(b => { const li = document.createElement("li"); li.textContent = b; ul.appendChild(li); });
      const n = document.createElement("span"); n.className = "n"; n.textContent = i + 2;
      el.append(h, ul, n);
      box.appendChild(el);
    });
    $("deckTitle").textContent = deck.title;
    $("export").disabled = false;
  }

